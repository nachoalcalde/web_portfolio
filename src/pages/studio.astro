---
import Layout from '../layouts/Layout.astro';
import GrainOverlay from '../components/GrainOverlay.astro';
import LocationRail from '../components/LocationRail.astro';
import SiteHeader from '../components/SiteHeader.astro';

const EMAIL = 'ialcaldecid@gmail.com';

const TITLE = 'Something is being built here.';

// One stagger across the whole sentence: the count runs on through the word
// gaps, so each word starts where the last one left off.
let letter = 0;
const WORDS = TITLE.split(' ').map((word) =>
  word.split('').map((char) => ({ char, delay: 0.3 + 0.03 * letter++ }))
);

// Two clocks per letter: `rise` is the entrance, `build` is where it joins the
// fill loop, which walks the word left to right and then starts again.
const GIANT = 'STUDIO'.split('').map((char, index) => ({
  char,
  rise: 0.6 + index * 0.06,
  build: 2 + index * 0.32,
}));

const delay = (seconds: number) => `animation-delay:${seconds.toFixed(2)}s`;
---

<Layout
  title="Studio — Nacho Alcalde Cid"
  description="Small, deliberate work for people who need one good thing rather than a six-month project. Being built."
>
  <div class="page" data-studio>
    <div class="grid" aria-hidden="true"></div>
    <div class="grid spotlight" aria-hidden="true"></div>

    <SiteHeader current="studio" />

    <main class="main">
      <div class="eyebrow">
        <span class="eyebrow-label">Studio — 2026</span>
        <span class="eyebrow-rule"><span class="scan"></span></span>
      </div>

      <h1 class="title">
        <span class="sr-only">{TITLE}</span>
        {
          WORDS.map((letters, index) => (
            <span class="word" aria-hidden="true">
              {letters.map(({ char, delay: seconds }) => (
                <span class="mask">
                  <span class="glyph" style={delay(seconds)}>{char}</span>
                </span>
              ))}
              {index === WORDS.length - 1 && <span class="caret" />}
            </span>
          ))
        }
      </h1>

      <div class="foot">
        <p class="lede">
          Small, deliberate, and for people who need one good thing rather than a six-month project.
          Same tools and same judgement as this site — <span class="lede-ink">you are looking at the first one.</span>
        </p>

        <div class="notify">
          <span class="eyebrow-label">Be the first to hear</span>
          <div class="notify-row">
            <a class="big-link notify-link" href={`mailto:${EMAIL}?subject=Studio`}>{EMAIL}</a>
            {/* Needs the clipboard API, so it only appears once the script has
                run; without it the address is still a link and still selectable. */}
            <button class="copy" type="button" data-copy={EMAIL} hidden>Copy</button>
            <span class="sr-only" role="status" data-copy-status></span>
          </div>
        </div>
      </div>
    </main>

    <div class="giant" aria-hidden="true">
      <div class="giant-word">
        {
          GIANT.map(({ char, rise, build }) => (
            <span class="giant-mask">
              <span class="giant-letter" style={delay(rise)}>
                <span class="giant-outline">{char}</span>
                <span class="giant-fill" style={delay(build)}>{char}</span>
              </span>
            </span>
          ))
        }
      </div>
    </div>

    <LocationRail label="Under construction" />

    <GrainOverlay />
  </div>
</Layout>

<style>
  .page {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    min-height: 100svh;
    padding: 26px var(--gutter) 0;
    padding-right: max(var(--gutter), env(safe-area-inset-right, 0px));
    padding-left: max(var(--gutter), env(safe-area-inset-left, 0px));
    background: var(--bg);
    color: var(--ink);
    font-family: var(--font-text);
  }

  /* A blueprint behind everything: faint 88px lines drifting diagonally, one
     cell every 40 seconds. */
  .grid {
    position: absolute;
    inset: 0;
    z-index: 0;
    pointer-events: none;
    background-image:
      linear-gradient(to right, rgba(243, 239, 231, 0.035) 1px, transparent 1px),
      linear-gradient(to bottom, rgba(243, 239, 231, 0.035) 1px, transparent 1px);
    background-size: 88px 88px;
    animation:
      fade 2.4s ease 0.4s both,
      drift 40s linear infinite;
  }

  /* The same grid at four times the strength, masked to a circle that follows
     the pointer. It lines up with the faint one because both share the size
     and the drift. Only for a mouse: on touch it would sit parked at its
     starting point doing nothing. */
  .spotlight {
    z-index: 1;
    display: none;
    background-image:
      linear-gradient(to right, var(--hairline) 1px, transparent 1px),
      linear-gradient(to bottom, var(--hairline) 1px, transparent 1px);
    -webkit-mask-image: radial-gradient(260px circle at var(--mx, 70%) var(--my, 40%), #000, transparent 70%);
    mask-image: radial-gradient(260px circle at var(--mx, 70%) var(--my, 40%), #000, transparent 70%);
    animation:
      fade 2s ease 1.2s both,
      drift 40s linear infinite;
  }

  @media (hover: hover) and (pointer: fine) {
    .spotlight {
      display: block;
    }
  }

  @keyframes drift {
    from {
      background-position: 0 0, 0 0;
    }
    to {
      background-position: 88px 88px, 88px 88px;
    }
  }

  .main {
    position: relative;
    z-index: 3;
    flex: 1;
    display: flex;
    flex-direction: column;
    justify-content: center;
    width: 100%;
    max-width: 1320px;
    margin: 0 auto;
    padding: clamp(48px, 9svh, 120px) 0 clamp(36px, 6svh, 80px);
  }

  .eyebrow {
    display: flex;
    align-items: center;
    gap: 12px;
    max-width: 560px;
    margin-bottom: clamp(22px, 3.4svh, 40px);
    animation: fade 1s ease 0.2s both;
  }

  .eyebrow-label {
    font-size: 11px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    white-space: nowrap;
    color: var(--ink-faint);
  }

  /* The rule draws itself in, then a short accent segment keeps crossing it:
     the one sign on the page that work is in progress, besides the caret. */
  .eyebrow-rule {
    position: relative;
    flex: 1;
    height: 1px;
    overflow: hidden;
    background: var(--hairline);
    transform-origin: left;
    animation: draw 1.2s var(--ease-out) 0.5s both;
  }

  .scan {
    position: absolute;
    top: 0;
    left: 0;
    width: 18%;
    height: 1px;
    background: var(--accent);
    animation: scan 2.8s cubic-bezier(0.6, 0, 0.4, 1) 1.6s infinite both;
  }

  @keyframes draw {
    from {
      transform: scaleX(0);
    }
    to {
      transform: scaleX(1);
    }
  }

  @keyframes scan {
    from {
      transform: translateX(-100%);
    }
    to {
      transform: translateX(560%);
    }
  }

  .title {
    display: flex;
    flex-wrap: wrap;
    column-gap: 0.24em;
    max-width: 13ch;
    margin: 0;
    font-family: var(--font-display);
    font-weight: 500;
    font-size: clamp(36px, min(5.6vw, 9.5svh), 96px);
    line-height: 0.96;
    letter-spacing: -0.045em;
    color: var(--ink);
  }

  /* Words wrap as wholes; the letters inside one never do. */
  .word {
    display: inline-flex;
    white-space: nowrap;
  }

  /* The padding gives descenders room inside the mask, the negative margin
     takes that room back out of the line. */
  .mask {
    display: inline-block;
    overflow: hidden;
    padding-bottom: 0.08em;
    margin-bottom: -0.08em;
  }

  .glyph {
    display: inline-block;
    animation: riseUp 1s var(--ease-rise) both;
  }

  .caret {
    align-self: center;
    display: inline-block;
    width: 0.07em;
    height: 0.78em;
    margin-left: 0.08em;
    background: var(--accent);
    animation:
      fade 0.3s ease 1.5s both,
      blink 1.1s steps(1) 1.8s infinite;
  }

  @keyframes blink {
    0%,
    49% {
      opacity: 1;
    }
    50%,
    100% {
      opacity: 0;
    }
  }

  .foot {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: clamp(28px, 4svh, 48px) clamp(32px, 6vw, 120px);
    margin-top: clamp(28px, 5svh, 64px);
  }

  .lede {
    max-width: 44ch;
    margin: 0;
    font-size: clamp(14px, 1vw, 16px);
    line-height: 1.6;
    text-wrap: pretty;
    color: var(--ink-dim);
    animation: rise 1s var(--ease-out) 1.1s both;
  }

  .lede-ink {
    color: var(--ink);
  }

  .notify {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 12px;
    animation: rise 1s var(--ease-out) 1.4s both;
  }

  .notify-row {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 10px 20px;
  }

  /* `.big-link` a size up: here it is the page's one call to action. */
  .notify-link {
    padding-bottom: 5px;
    font-weight: 500;
    font-size: clamp(20px, 2vw, 32px);
    letter-spacing: -0.02em;
  }

  .copy {
    padding: 0;
    border: 0;
    background: none;
    font-family: var(--font-text);
    font-size: 11px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--ink-dim);
    cursor: pointer;
    transition: color 0.22s;
  }

  .copy:hover {
    color: var(--accent);
  }

  /* The word itself, drawn in outline and standing whole on the bottom edge of
     the first screen. Its size is capped by the height as well as the width,
     so on a wide, short screen it shrinks rather than pushing below the fold. */
  .giant {
    position: relative;
    z-index: 2;
    display: flex;
    justify-content: center;
    padding-bottom: clamp(14px, 3svh, 36px);
    margin: 0 calc(var(--gutter) * -1);
    overflow: hidden;
    pointer-events: none;
  }

  .giant-word {
    display: flex;
    font-family: var(--font-display);
    font-weight: 600;
    font-size: min(20.5vw, 36svh);
    line-height: 0.8;
    letter-spacing: -0.05em;
    white-space: nowrap;
  }

  .giant-mask {
    display: inline-block;
    overflow: hidden;
    padding: 0.12em 0.08em 0;
    margin: -0.12em -0.08em 0;
  }

  .giant-letter {
    position: relative;
    display: inline-block;
    animation: riseUp 1.2s var(--ease-rise) both;
  }

  .giant-outline {
    color: transparent;
    -webkit-text-stroke: 1px var(--hairline-strong);
  }

  /* A solid copy over each outline, wiped in from below and out through the
     top, one letter after the next: the word being built and taken down. */
  .giant-fill {
    position: absolute;
    top: 0;
    left: 0;
    color: var(--ink);
    animation: build 9s cubic-bezier(0.7, 0, 0.2, 1) infinite both;
  }

  @keyframes build {
    0% {
      clip-path: inset(110% -25% -25% -25%);
    }
    14% {
      clip-path: inset(-25% -25% -25% -25%);
    }
    62% {
      clip-path: inset(-25% -25% -25% -25%);
    }
    76% {
      clip-path: inset(-25% -25% 110% -25%);
    }
    100% {
      clip-path: inset(-25% -25% 110% -25%);
    }
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }

  /* The global reduced-motion rule runs every animation once and instantly,
     which would leave the caret on the blink's last frame: invisible. It is
     meant to stay lit. */
  @media (prefers-reduced-motion: reduce) {
    .caret {
      animation: fade 0.3s ease 1.5s both;
    }
  }

  /* From here down the header is fixed, so the page has to open below it
     rather than under it. */
  @media (max-width: 1199px) {
    .page {
      padding-top: var(--header-h);
    }

    /* The gutter stops clearing the rail once it shrinks: the lede and the
       Copy button would run into the vertical type at the screen edge. */
    .main {
      padding-right: 14px;
    }
  }

  @media (max-width: 639px) {
    .lede {
      font-size: 16px;
    }

    /* A thumb-sized target around the small caps, without moving them. */
    .copy {
      position: relative;
    }

    .copy::before {
      content: '';
      position: absolute;
      inset: -12px -10px;
    }
  }

  /* Landscape phones: height is what runs out, so the headline sizes off it. */
  @media (max-height: 560px) and (orientation: landscape) {
    .main {
      padding-top: clamp(24px, 6svh, 56px);
      padding-bottom: clamp(24px, 6svh, 56px);
    }

    .title {
      max-width: none;
      font-size: clamp(32px, 12svh, 64px);
    }
  }
</style>

<script>
  const page = document.querySelector<HTMLElement>('[data-studio]');

  // Moves the spotlight. One write per frame at most, however fast the events
  // come in.
  if (page && window.matchMedia('(hover: hover) and (pointer: fine)').matches) {
    let frame = 0;
    let x = 0;
    let y = 0;

    page.addEventListener('pointermove', (event) => {
      x = event.clientX;
      y = event.clientY;
      if (frame) return;

      frame = requestAnimationFrame(() => {
        frame = 0;
        const box = page.getBoundingClientRect();
        page.style.setProperty('--mx', `${x - box.left}px`);
        page.style.setProperty('--my', `${y - box.top}px`);
      });
    });
  }

  const copy = document.querySelector<HTMLButtonElement>('[data-copy]');
  const status = document.querySelector<HTMLElement>('[data-copy-status]');

  if (copy && navigator.clipboard) {
    let reset = 0;
    copy.hidden = false;

    copy.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(copy.dataset.copy ?? '');
      } catch {
        // Denied or unavailable: say nothing rather than claim a copy that
        // did not happen. The link beside it still works.
        return;
      }

      copy.textContent = 'Copied';
      if (status) status.textContent = 'Address copied';

      clearTimeout(reset);
      reset = window.setTimeout(() => {
        copy.textContent = 'Copy';
        if (status) status.textContent = '';
      }, 1800);
    });
  }
</script>
