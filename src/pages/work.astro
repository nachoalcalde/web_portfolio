---
import { Image } from 'astro:assets';

import Layout from '../layouts/Layout.astro';
import ExperienceEntry from '../components/ExperienceEntry.astro';
import GrainOverlay from '../components/GrainOverlay.astro';
import LocationRail from '../components/LocationRail.astro';
import ScrollReveal from '../components/ScrollReveal.astro';
import SectionHead from '../components/SectionHead.astro';
import SiteHeader from '../components/SiteHeader.astro';

import flagBr from '../assets/flag-br.png';
import flagEn from '../assets/flag-en.png';
import flagEs from '../assets/flag-es.png';
import iconAi from '../assets/icon-ai.png';
import iconAiAccent from '../assets/icon-ai-accent.png';
import logoEy from '../assets/logo-ey.png';
import logoSanitas from '../assets/logo-sanitas-blue.png';

const EMAIL = 'ialcaldecid@gmail.com';
const LINKEDIN = 'https://www.linkedin.com/in/ignacioalcaldecid/';

const FIGURES = [
  { value: '~150', label: 'Projects in the portfolio I own' },
  { value: '7', label: 'Markets in Europe & Latin America' },
  { value: '6', label: 'M&A security due diligences' },
  { value: '10+', label: 'Proposals written and priced' },
];

const AI_ITEMS = [
  {
    label: 'Agentic tooling',
    copy: 'Analysis, reporting and internal tools built with Claude Code, MCP servers, custom skills and plugins.',
  },
  {
    label: 'Things I ship myself',
    copy: 'An IoT camera on a Raspberry Pi that detects cats autonomously, hardware to deployment. An AI-assisted system for managing my own finances.',
  },
  {
    label: 'This portfolio',
    copy: 'Designed and built with Claude Design and Claude Code — layout, copy and code, iterated the same way I run anything else.',
  },
  {
    label: 'Since 2018',
    copy: 'Following the field since university: model releases, tooling and evaluation practice, as a matter of course.',
  },
];

const SKILLS = [
  {
    title: 'Commercial & value',
    items: [
      'Business case development',
      'Proposal scoping, effort estimation and pricing',
      'C-level stakeholder management',
      'Prioritisation and funding across a multi-market portfolio',
    ],
  },
  {
    title: 'Delivery',
    items: [
      'Portfolio and programme management',
      '~150 projects, 5 teams, 7 markets',
      'M&A due diligence',
      'Post-merger integration',
    ],
  },
  {
    title: 'Domain',
    items: [
      'Enterprise security and risk',
      'NIST CSF · ISO 27001/27002 · ISO 22301',
      'DORA and operational resilience',
      'SWIFT CSP · Third-party risk',
      'Cloud governance (Azure, AWS)',
    ],
  },
];

// `level` is both the label and the bar: one number, so the two cannot disagree.
const LANGUAGES = [
  { name: 'Spanish', note: 'Native', level: 100, flag: flagEs, country: 'Spain' },
  { name: 'English', note: 'Fluent, daily at work', level: 92, flag: flagEn, country: 'United Kingdom' },
  { name: 'Portuguese', note: 'Learning', level: 35, flag: flagBr, country: 'Brazil' },
];

const BEYOND = [
  { label: 'Live music', copy: 'Guitar and bass in a gigging band, with regular live performances.' },
  {
    label: 'On the road',
    copy: 'Merchandise sales for touring bands at live venues since 2017. Direct selling to the public.',
  },
  {
    label: 'Volunteering',
    copy: 'With people at risk of social exclusion, the elderly, and children of single mothers.',
  },
  { label: 'Sport', copy: 'Golf, padel, CrossFit, skiing and surfing.' },
  {
    label: 'In the garage',
    copy: 'Restoring a Suzuki Samurai for the countryside. Ongoing, and mostly my own hands.',
  },
];
---

<Layout
  title="Work — Nacho Alcalde Cid"
  description="Cyber security governance and strategy at Sanitas (Bupa), after four and a half years of consulting at EY."
>
  <div class="page">
    <ScrollReveal />

    <SiteHeader current="work" />

    <main>
      <section class="section hero">
        <SectionHead heading="span" label="Work" space="xs" />

        <div class="hero-row">
          <h1 class="hero-title">
            Turning security risk into decisions the business can actually take.
          </h1>
          <p class="hero-intro">
            Four and a half years in consulting, writing and pricing the work. Now governance and
            strategy across seven markets of an international insurance group. A portfolio I
            prioritise but don’t control, so everything in it has to be worth funding first.
          </p>
        </div>
      </section>

      <section class="section figures" aria-label="In numbers" data-reveal>
        {
          FIGURES.map((figure) => (
            <div class="figure">
              <div class="figure-value">{figure.value}</div>
              <div class="figure-label">{figure.label}</div>
            </div>
          ))
        }

        {/* Not a figure: the sign-off that hands the strip over to the detail
            below it, which is why it is the one cell in a dimmer ink. */}
        <div class="figure figure-more">
          <div class="figure-value">&amp; more</div>
          <div class="figure-label">Below</div>
        </div>
      </section>

      <section class="section">
        <SectionHead label="Experience" space="lg" reveal />

        <ExperienceEntry
          title="Sanitas"
          titleMuted="Bupa Group"
          start="May 2025"
          end="Present"
          present
          meta={[
            'Cyber Security Governance & Strategy',
            'Insurance & health',
            'Europe & Latin America',
            'Madrid',
          ]}
          tone="current"
        >
          <Image slot="logo" class="logo logo-sanitas" src={logoSanitas} alt="Sanitas" height={96} />

          <p class="summary">
            I run the group’s cyber portfolio and the framework seven very different levels of
            maturity have to live with. My job is prioritisation and reporting into the CISO office,
            and then taking the same decisions to market security and IT leadership as a case they
            can fund.
          </p>

          <ol class="points">
            <li>
              <p>
                <span class="lead">PMO for a ~150-project portfolio</span> delivered by five manager-led
                teams across seven markets. I own prioritisation, quarterly review and what gets funded.
              </p>
            </li>
            <li>
              <p>
                <span class="lead">Six security due diligences on acquisitions.</span> Assessment under
                real time and information constraints, cost-to-remediate for the deal team, then
                integration into the group model after close.
              </p>
            </li>
            <li>
              <p>
                <span class="lead">Framework adoption across seven markets.</span> I translated the
                group’s NIST CSF standards and metrics into a model each country could implement at its
                own level of maturity, and agreed it market by market.
              </p>
            </li>
            <li>
              <p>
                <span class="lead">Built my own reporting tooling with agentic AI:</span> portfolio
                dashboards across seven markets of data, instead of waiting on a BI backlog. Plus the
                programme to secure internet-facing assets, and post-incident governance: root cause,
                remediation plan and the funding case behind it.
              </p>
            </li>
          </ol>
        </ExperienceEntry>

        <ExperienceEntry
          title="EY"
          titleMuted="Financial Services"
          start="Jan 2021"
          end="May 2025"
          meta={[
            'Senior Consultant 2024–2025',
            'Consultant 2021–2024',
            'Banking, insurance & health',
            'Madrid',
          ]}
          tone="past"
        >
          <Image slot="logo" class="logo logo-ey" src={logoEy} alt="EY" height={92} />

          <p class="summary">
            Four and a half years on the scope, effort and pricing behind proposals to <span
              class="lead">banks</span
            > and <span class="lead">insurers</span>, and on the security assessment and strategy work
            for some of the largest financial and health groups in the market: <span class="lead"
              >Santander</span
            > (SCIB, Wealth Management, Santander España), <span class="lead">CaixaBank</span>, <span
              class="lead">AXA</span
            >, <span class="lead">ASISA</span>, <span class="lead">BPI</span> and <span class="lead"
              >Sanitas</span
            >.
          </p>

          <ol class="points">
            <li>
              <p>
                <span class="lead">Wrote and scoped 10+ proposals</span> for new and follow-on
                engagements: client need, solution approach, effort model and pricing, for partner-led
                pitches into banking and insurance.
              </p>
            </li>
            <li>
              <p>
                <span class="lead">Ran up to three concurrent engagements</span> end to end: workplan,
                delivery and the CISO-level relationship, while writing new business alongside them.
              </p>
            </li>
            <li>
              <p>
                <span class="lead">Security assessment and strategy for banks, insurers and health
                  groups:</span
                > gap assessment, control design and implementation roadmaps against ISO 27001/27002 and
                NIST, with the reporting that took each one to the client’s CISO.
              </p>
            </li>
            <li>
              <p>
                <span class="lead">Designed the third-party risk model and process for a tier-1 bank</span
                > on a six-month engagement, and ran supplier assessments against it. Delivered into
                Santander. Mentored junior consultants as Senior Consultant.
              </p>
            </li>
            <li>
              <p>
                <span class="lead">Other projects:</span> cloud security governance across Azure and AWS,
                operational resilience and business continuity (ISO 22301, DORA), and compliance
                programmes against PCI-DSS and SWIFT CSP.
              </p>
            </li>
          </ol>
        </ExperienceEntry>

        <ExperienceEntry
          title="Universidad Francisco de Vitoria"
          titleMuted="IT Support Technician"
          start="Sep 2019"
          end="Jun 2020"
          meta={['Alongside my degree', 'Madrid']}
          scale="sm"
          tone="archive"
        >
          <p class="summary summary-sm">
            I ran university IT support while studying Computer Engineering at the same university.
            My first paid technical work, in parallel with the degree.
          </p>
        </ExperienceEntry>

        <ExperienceEntry
          title="BSc Computer Engineering"
          titleMuted="Universidad Francisco de Vitoria"
          start="2018"
          end="2021"
          meta={['Madrid']}
          tag="Education"
          scale="sm"
          tone="education"
        >
          <p class="summary summary-sm">
            Software, networks and systems. The technical base everything since then has been built
            on, and the reason I can still build the tooling myself.
          </p>
        </ExperienceEntry>
      </section>

      <section class="section ai" data-reveal>
        <SectionHead label="AI in practice" tone="strong" icon={iconAi} />

        <div class="split">
          <p class="split-lead">
            I build with AI daily, and it is increasingly what these decisions turn on.
          </p>
          <ul class="ai-list">
            {
              AI_ITEMS.map((item) => (
                <li>
                  <Image class="ai-mark" src={iconAiAccent} alt="" height={26} aria-hidden="true" />
                  <div class="ai-item">
                    <h3 class="ai-label">{item.label}</h3>
                    <p class="ai-copy">{item.copy}</p>
                  </div>
                </li>
              ))
            }
          </ul>
        </div>
      </section>

      <section class="section skills" data-reveal>
        <SectionHead label="Skills & languages" tone="strong" />

        <div class="columns">
          {
            SKILLS.map((column) => (
              <div class="column">
                <h3 class="column-title">{column.title}</h3>
                <ul class="skill-list">
                  {column.items.map((item) => (
                    <li>{item}</li>
                  ))}
                </ul>
              </div>
            ))
          }

          <div class="column">
            <h3 class="column-title">Languages</h3>
            <ul class="language-list">
              {
                LANGUAGES.map((language) => (
                  <li class="language">
                    <div class="language-head">
                      <span class="language-name">{language.name}</span>
                      <span class="language-note">{language.note}</span>
                    </div>
                    {/* The level is already written out beside the name, so the
                        bar is decoration and stays out of the reading order. */}
                    <div class="language-bar" aria-hidden="true">
                      <Image
                        class="flag"
                        src={language.flag}
                        alt=""
                        width={20}
                        height={20}
                        densities={[1, 2]}
                      />
                      <span class="track">
                        <span class="fill" style={`width:${language.level}%`} />
                      </span>
                    </div>
                  </li>
                ))
              }
            </ul>
          </div>
        </div>
      </section>

      <section class="section beyond" data-reveal>
        <SectionHead label="Beyond work" space="sm" />

        <div class="beyond-row">
          {
            BEYOND.map((item) => (
              <div class="beyond-item">
                <h3 class="beyond-label">{item.label}</h3>
                <p class="beyond-copy">{item.copy}</p>
              </div>
            ))
          }
        </div>
      </section>
    </main>

    <footer class="section footer" data-reveal>
      <div class="footer-lead">
        <p class="footer-line">
          Happy to talk shop with anyone working on this kind of problem.
        </p>
        <div class="footer-links">
          <a class="big-link" href={`mailto:${EMAIL}`}>{EMAIL}</a>
          <a class="big-link" href={LINKEDIN} target="_blank" rel="noopener">LinkedIn</a>
        </div>
      </div>

      <div class="elsewhere">
        <span class="elsewhere-label">Elsewhere</span>
        <a class="big-link" href="/">Home</a>
      </div>
    </footer>

    <LocationRail />

    <GrainOverlay />
  </div>
</Layout>

<style>
  .page {
    position: relative;
    min-height: 100svh;
    padding: 26px var(--gutter) 0;
    padding-right: max(var(--gutter), env(safe-area-inset-right, 0px));
    padding-left: max(var(--gutter), env(safe-area-inset-left, 0px));
    background: var(--bg);
    color: var(--ink);
    font-family: var(--font-text);
  }

  /* One column for the whole page. Every section is a band inside it, and the
     hairlines are what separate them, never a change of surface. */
  .section {
    position: relative;
    z-index: 2;
    max-width: 1320px;
    margin: 0 auto;
  }

  .hero {
    padding: clamp(56px, 11vh, 140px) 0 clamp(40px, 6vw, 86px);
    animation: fade 1s ease both;
  }

  .hero-row {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    gap: clamp(28px, 4vw, 72px);
    animation: rise 1s var(--ease-out) both;
  }

  /* 420px each: they sit side by side while both fit a comfortable measure and
     stack the moment they do not, which is the page's only layout rule. */
  .hero-title {
    flex: 1 1 420px;
    min-width: min(100%, 300px);
    max-width: 820px;
    margin: 0;
    font-family: var(--font-display);
    font-weight: 500;
    font-size: clamp(30px, 4.6vw, 74px);
    line-height: 1.02;
    letter-spacing: -0.03em;
    text-wrap: pretty;
    color: var(--ink);
  }

  .hero-intro {
    flex: 0 1 420px;
    min-width: min(100%, 280px);
    max-width: 460px;
    margin: 0;
    font-size: 17px;
    line-height: 1.5;
    text-wrap: pretty;
    color: var(--ink-muted);
  }

  .figures {
    display: flex;
    flex-wrap: wrap;
    margin-bottom: clamp(30px, 3.4vw, 46px);
    border-top: 1px solid var(--hairline);
  }

  .figure {
    flex: 1 1 200px;
    min-width: min(100%, 180px);
    padding: clamp(20px, 2.4vw, 32px) clamp(16px, 2vw, 28px);
  }

  /* The outer cells give up their side padding so the strip starts and ends on
     the same line as every other section. */
  .figure:first-child {
    padding-left: 0;
  }

  .figure-more {
    flex: 0 1 auto;
    padding-right: 0;
  }

  .figure-value {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: clamp(34px, 4vw, 58px);
    line-height: 1;
    letter-spacing: -0.04em;
    font-variant-numeric: tabular-nums;
    color: var(--ink);
  }

  .figure-more .figure-value {
    font-weight: 500;
    letter-spacing: -0.03em;
    white-space: nowrap;
    color: var(--ink-disabled);
  }

  .figure-label {
    margin-top: 12px;
    font-size: 12.5px;
    line-height: 1.45;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--ink-muted);
  }

  .figure-more .figure-label {
    color: var(--ink-faint);
  }

  /* Authored here rather than in ExperienceEntry: they are slotted in from this
     page, so this page's scope is the one that reaches them. */
  .summary {
    margin: 0;
    max-width: 82ch;
    font-size: 15.5px;
    line-height: 1.6;
    text-wrap: pretty;
    color: var(--ink-dim);
  }

  .summary-sm {
    font-size: 15px;
    line-height: 1.55;
  }

  /* Schibsted is loaded at 400 and 500 only, so emphasis in body copy is a
     change of ink, never of weight. */
  .lead {
    color: var(--ink);
  }

  /* An ordered list, with the design's 01–05 drawn by the counter: the numbers
     cannot fall out of step with the copy when a point is added or moved. */
  .points {
    margin: clamp(22px, 2.6vw, 34px) 0 0;
    padding: 0;
    /* On the list rather than on its last row: the rule closes the block, and
       a row added at the end cannot leave it behind. */
    border-bottom: 1px solid var(--hairline);
    counter-reset: point;
    list-style: none;
  }

  .points li {
    display: flex;
    gap: clamp(12px, 1.4vw, 20px);
    padding: 15px 0;
    border-top: 1px solid var(--hairline);
  }

  .points p {
    margin: 0;
    max-width: 88ch;
    font-size: 15px;
    line-height: 1.55;
    text-wrap: pretty;
    color: var(--ink-dim);
  }

  .points li::before {
    content: counter(point, decimal-leading-zero);
    counter-increment: point;
    flex: 0 0 auto;
    padding-top: 2px;
    font-family: var(--font-display);
    font-size: 12px;
    font-variant-numeric: tabular-nums;
    color: var(--accent);
  }

  /* Height-driven, because what has to match across the two logos is their
     optical weight on the title's baseline, not their width. The lift is the
     white space each mark carries under it. */
  .logo {
    flex: 0 0 auto;
    width: auto;
  }

  .logo-sanitas {
    height: clamp(36px, 3.1vw, 48px);
    margin-bottom: 5px;
  }

  .logo-ey {
    height: clamp(32px, 2.9vw, 46px);
    margin-bottom: 6px;
    /* The brand yellow is the one colour on the page outside the system; a
       touch of transparency settles it into the dark ground. */
    opacity: 0.92;
  }

  .ai {
    padding: clamp(36px, 5vw, 84px) 0 clamp(56px, 7vw, 110px);
  }

  .split {
    display: flex;
    flex-wrap: wrap;
    gap: clamp(24px, 3.4vw, 64px);
  }

  .split-lead {
    flex: 1 1 380px;
    min-width: min(100%, 280px);
    max-width: 620px;
    margin: 0;
    font-family: var(--font-display);
    font-weight: 500;
    font-size: clamp(20px, 2.2vw, 34px);
    line-height: 1.15;
    letter-spacing: -0.025em;
    text-wrap: pretty;
    color: var(--ink);
  }

  /* Same construction as the timeline's points: rows divided by hairlines, with
     the closing rule on the list so a row added at the end cannot lose it. */
  .ai-list {
    flex: 1 1 320px;
    min-width: min(100%, 280px);
    max-width: 560px;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    border-bottom: 1px solid var(--hairline);
    list-style: none;
  }

  .ai-list li {
    display: flex;
    gap: clamp(14px, 1.8vw, 26px);
    padding: 15px 0;
    border-top: 1px solid var(--hairline);
  }

  .ai-mark {
    flex: 0 0 auto;
    display: block;
    width: 11px;
    height: 13px;
    margin-top: 5px;
  }

  /* min-width:0 so a long unbroken string cannot push the row wider than the
     column and drag the hairlines with it. */
  .ai-item {
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 7px;
  }

  .ai-label {
    margin: 0;
    font-weight: 400;
    font-size: 12px;
    letter-spacing: 0.13em;
    text-transform: uppercase;
    color: var(--ink);
  }

  .ai-copy {
    margin: 0;
    font-size: 14.5px;
    line-height: 1.6;
    text-wrap: pretty;
    color: var(--ink-dim);
  }

  .skills {
    padding-bottom: clamp(56px, 7vw, 110px);
  }

  .columns {
    display: flex;
    flex-wrap: wrap;
    gap: clamp(28px, 3.4vw, 64px);
  }

  .column {
    flex: 1 1 240px;
    min-width: min(100%, 220px);
  }

  .column-title {
    margin: 0 0 18px;
    font-family: var(--font-display);
    font-weight: 400;
    font-size: 13px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    white-space: nowrap;
    color: var(--accent);
  }

  .skill-list {
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 11px;
    list-style: none;
  }

  /* The marker is drawn rather than listed: a list-style bullet cannot be put
     on the accent, at 5px, 9px down from the top of a wrapping line. */
  .skill-list li {
    display: flex;
    align-items: flex-start;
    gap: 11px;
    font-size: 17px;
    line-height: 1.35;
    letter-spacing: -0.005em;
    text-wrap: pretty;
    color: var(--ink);
  }

  .skill-list li::before {
    content: '';
    flex: 0 0 auto;
    width: 5px;
    height: 5px;
    margin-top: 9px;
    border-radius: 999px;
    background: var(--accent);
  }

  .language-list {
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 16px;
    list-style: none;
  }

  .language {
    display: flex;
    flex-direction: column;
    gap: 7px;
  }

  .language-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 12px;
  }

  .language-name {
    font-size: 17px;
    line-height: 1.2;
    color: var(--ink);
  }

  .language-note {
    font-family: var(--font-display);
    font-size: 11px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    white-space: nowrap;
    color: var(--ink-dim);
  }

  .language-bar {
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .flag {
    flex: 0 0 auto;
    display: block;
    width: 20px;
    height: 20px;
    border-radius: 999px;
  }

  .track {
    flex: 1;
    display: block;
    height: 4px;
    overflow: hidden;
    border-radius: 999px;
    background: var(--hairline);
  }

  .fill {
    display: block;
    height: 100%;
    border-radius: 999px;
    background: var(--accent);
  }

  .beyond {
    padding-bottom: clamp(56px, 7vw, 110px);
  }

  /* Five equal columns that become two, then one: `flex: 1 1 0` with a floor,
     so they share the row evenly instead of sizing off their copy. */
  .beyond-row {
    display: flex;
    flex-wrap: wrap;
    gap: clamp(18px, 2.2vw, 34px);
  }

  .beyond-item {
    flex: 1 1 0;
    min-width: 150px;
    display: flex;
    flex-direction: column;
    gap: 9px;
  }

  .beyond-label {
    margin: 0;
    font-family: var(--font-display);
    font-weight: 400;
    font-size: 12.5px;
    letter-spacing: 0.13em;
    text-transform: uppercase;
    color: var(--ink);
  }

  .beyond-copy {
    margin: 0;
    font-size: 13.5px;
    line-height: 1.55;
    text-wrap: pretty;
    color: var(--ink-dim);
  }

  .footer {
    display: flex;
