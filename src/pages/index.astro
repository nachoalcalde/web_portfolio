---
import Layout from '../layouts/Layout.astro';
import GrainOverlay from '../components/GrainOverlay.astro';
import LocationRail from '../components/LocationRail.astro';
import NameMarquee from '../components/NameMarquee.astro';
import Portrait from '../components/Portrait.astro';
import SiteHeader from '../components/SiteHeader.astro';

const EMAIL = 'ialcaldecid@gmail.com';
const LINKEDIN = 'https://www.linkedin.com/in/ignacioalcaldecid/';
---

<Layout
  title="Nacho Alcalde Cid"
  description="Security strategy in Sanitas (Bupa) across seven markets in Europe and Latin America."
>
  <div class="page">
    <SiteHeader current="home" />

    <main class="main">
      <section class="pitch">
        <div class="eyebrow">
          <span class="eyebrow-label">What I bring</span>
          <span class="eyebrow-rule"></span>
        </div>
        <p class="pitch-copy">
          I work on problems that are broad, badly defined and spread across a lot of people.
        </p>
      </section>

      {/* Reserves the portrait's column while the portrait is a background
          layer; from 1199px down the portrait joins the flow and this goes. */}
      <div class="portrait-spacer" aria-hidden="true"></div>

      <section class="aside">
        <p class="now">
          <span class="now-label">Right now:</span> security strategy in <a class="inline-link" href="https://www.sanitas.es" target="_blank" rel="noopener">Sanitas</a> (Bupa) across seven markets in Europe and Latin America.
        </p>

        <div class="contact">
          <span class="eyebrow-label">Get in touch</span>
          <a class="big-link contact-link" href={LINKEDIN} target="_blank" rel="noopener">LinkedIn</a>
          <a class="big-link contact-link" href={`mailto:${EMAIL}`}>{EMAIL}</a>
        </div>
      </section>
    </main>

    {/* `display: contents` above 640px, so on desktop these three stay direct
        children of .page and the layout is the one that was signed off. On a
        phone the wrapper becomes the one-screen hero and `order` lifts it above
        <main>, which then holds the rest of the page below the fold. */}
    <div class="hero">
      <Portrait />

      <NameMarquee />

      <LocationRail anchor="hero" />
    </div>

    <GrainOverlay />
  </div>
</Layout>

<style>
  .page {
    position: relative;
    overflow: hidden;
    min-height: 100vh;
    min-height: 100svh;
    display: flex;
    flex-direction: column;
    padding: 26px var(--gutter) 0;
    padding-right: max(var(--gutter), env(safe-area-inset-right, 0px));
    padding-left: max(var(--gutter), env(safe-area-inset-left, 0px));
    background: var(--bg);
    color: var(--ink);
    font-family: var(--font-text);
  }

  .main {
    position: relative;
    z-index: 2;
    flex: 1;
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: center;
    gap: clamp(24px, 3vw, 56px);
    padding: clamp(40px, 10vh, 130px) clamp(16px, 2vw, 28px) clamp(58px, 7.5vw, 140px) 0;
  }

  .pitch {
    flex: 1 1 240px;
    min-width: min(100%, 240px);
    max-width: 520px;
    animation: rise 1s var(--ease-out) both;
  }

  .eyebrow {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-bottom: 18px;
  }

  .eyebrow-label {
    font-size: 11px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--ink-faint);
  }

  .eyebrow-rule {
    flex: 1;
    height: 1px;
    background: var(--hairline);
  }

  .pitch-copy {
    margin: 0;
    font-family: var(--font-display);
    font-weight: 500;
    font-size: clamp(24px, 2.5vw, 42px);
    line-height: 1.08;
    letter-spacing: -0.025em;
    text-wrap: pretty;
    color: var(--ink);
  }

  /* 56svh is the reserved width the design asks for, and the columns are meant
     to tuck slightly over the figure's arms. --portrait-w caps it so that tuck
     cannot grow into the shirt on a very large screen, where 56svh would
     otherwise fall far short of the image. */
  .portrait-spacer {
    flex: 0 1 max(60px, min(56svh, var(--portrait-w)));
  }

  .hero {
    display: contents;
  }

  .aside {
    flex: 1 1 210px;
    min-width: min(100%, 210px);
    max-width: 380px;
    display: flex;
    flex-direction: column;
    gap: 20px;
    animation: rise 1.1s var(--ease-out) both;
  }

  .now {
    margin: 0;
    max-width: 34ch;
    font-size: 14px;
    line-height: 1.55;
    text-wrap: pretty;
    color: var(--ink-dim);
  }

  .now-label {
    color: var(--ink);
  }

  /* Keeps a standing underline rather than revealing itself only on hover, so
     the link is findable by keyboard and without relying on colour alone. */
  .inline-link {
    color: var(--ink);
    border-bottom: 1px solid var(--rule);
    transition:
      color 0.25s,
      border-color 0.25s;
  }

  .inline-link:hover {
    color: var(--accent);
    border-bottom-color: var(--accent);
  }

  .contact {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  /* Everything but the wrap comes from `.big-link` in global.css. */
  .contact-link {
    white-space: nowrap;
  }

  /* Tablets, narrow windows and phones held sideways: 240px + 210px of text
     plus the figure between them no longer fit on one line, so the figure takes
     the whole first screen and the copy moves below the fold. The header is
     fixed from here down, which is what lets the hero be exactly one screen. */
  @media (max-width: 1199px) {
    .page {
      padding-top: 0;
    }

    .hero {
      position: relative;
      display: flex;
      flex: 0 0 auto;
      flex-direction: column;
      justify-content: flex-end;
      min-height: 100svh;
    }

    /* `order` puts this after the hero on screen while leaving it before it in
       the source, so the copy is still what a screen reader reads first. */
    .main {
      order: 1;
      flex: 0 0 auto;
      flex-wrap: nowrap;
      align-items: flex-start;
      justify-content: space-between;
      gap: clamp(20px, 3.4vw, 44px);
      padding: clamp(40px, 8svh, 96px) 0 calc(clamp(48px, 8svh, 88px) + env(safe-area-inset-bottom, 0px));
    }

    .portrait-spacer {
      display: none;
    }

    .pitch {
      flex: 1 1 auto;
      max-width: 54%;
    }

    .aside {
      flex: 0 1 auto;
      max-width: min(40%, 380px);
      gap: 24px;
    }

    /* 2.5vw left the pitch at its 24px floor on every tablet, which read as
       desktop type squeezed into a phone. These are sized for the band. */
    .pitch-copy {
      font-size: clamp(30px, 4.6vw, 46px);
    }

    .eyebrow-label {
      font-size: 12px;
    }

    .now {
      max-width: 36ch;
      font-size: 16px;
      line-height: 1.5;
    }

    .contact-link {
      font-size: clamp(19px, 2.2vw, 24px);
    }
  }

  /* Phones: the copy below the fold goes to one column. */
  @media (max-width: 639px) {
    .main {
      flex-direction: column;
      align-items: stretch;
      gap: clamp(26px, 5svh, 44px);
      padding: clamp(44px, 9svh, 88px) 0 calc(clamp(52px, 9svh, 92px) + env(safe-area-inset-bottom, 0px));
    }

    .pitch,
    .aside {
      flex: 0 0 auto;
      min-width: 0;
      max-width: none;
    }

    /* Grows off the viewport width rather than 2.5vw, which would leave it at
       its 24px floor on every phone made. 8.8vw is ~39px on a Pro Max. */
    .pitch-copy {
      font-size: clamp(27px, 8.8vw, 42px);
    }

    /* No ch cap here: the column is already the screen, and 17px across a
       400px line is about 47 characters, well inside a comfortable measure. */
    .now {
      max-width: none;
      font-size: 17px;
      line-height: 1.5;
    }

    .contact {
      gap: 12px;
    }

    /* Same trick as the header's Contact: a thumb-sized hit area without
       moving the underline the design puts under each link. */
    .contact-link {
      position: relative;
      font-size: 20px;
    }

    .contact-link::before {
      content: '';
      position: absolute;
      inset: -8px -8px;
    }
  }

  /* Landscape phones and short windows. The name and the figure already shrink
     off svh in global.css; what is left is to stop the paddings from spending
     height the copy needs. */
  @media (max-height: 560px) and (orientation: landscape) {
    .main {
      padding: clamp(24px, 6svh, 56px) 0 calc(clamp(24px, 6svh, 56px) + env(safe-area-inset-bottom, 0px));
    }

    .pitch-copy {
      font-size: clamp(20px, 2.4vw, 30px);
    }
  }
</style>
