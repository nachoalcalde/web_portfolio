---
interface Props {
  title: string;
  /** Second term of the title: the group, or the institution. Always dimmer. */
  titleMuted: string;
  start: string;
  end: string;
  /** Marks the end date as ongoing, which is the one word the accent touches. */
  present?: boolean;
  meta: string[];
  /** A kicker over the title, for an entry that is not a job. */
  tag?: string;
  /** The entries that close the story come down a size. */
  scale?: 'lg' | 'sm';
  /** Timeline dot: how far back this sits, and whether it is work at all. */
  tone: 'current' | 'past' | 'archive' | 'education';
}

const {
  title,
  titleMuted,
  start,
  end,
  present = false,
  meta,
  tag,
  scale = 'lg',
  tone,
} = Astro.props;
---

<article class:list={['entry', scale, tone, { 'has-tag': tag }]} data-reveal>
  <div class="row">
    {/* Dates and facts on the left, out of the way of the reading column. */}
    <div class="rail">
      <span class="dates">
        {start} — {present ? <span class="present">{end}</span> : end}
      </span>

      <div class="meta">
        {meta.map((item) => <span>{item}</span>)}
      </div>
    </div>

    <div class="body">
      <span class="dot" aria-hidden="true"></span>

      {
        tag && (
          <div class="tag">
            <span class="tag-dot" aria-hidden="true" />
            <span class="tag-label">{tag}</span>
          </div>
        )
      }

      {/* flex-end rather than baseline: if the name wraps, a baseline alignment
          drops the logo onto its second line. */}
      <div class="head">
        <slot name="logo" />

        <h3 class="title">
          {title} <span class="muted">{titleMuted}</span>
        </h3>
      </div>

      <slot />
    </div>
  </div>
</article>

<style>
  .entry {
    position: relative;
    padding-bottom: clamp(48px, 6vw, 92px);
  }

  .lg {
    --title-size: clamp(26px, 3.2vw, 50px);
    --dot-shift: 0.52;
  }

  .sm {
    --title-size: clamp(20px, 2.1vw, 32px);
    --dot-shift: 0.55;
  }

  .row {
    display: flex;
    flex-wrap: wrap;
    gap: clamp(22px, 3vw, 56px);
  }

  /* Gives up its width first and takes the whole row once there is no space for
     two columns, which is what puts the facts above the entry on a phone. */
  .rail {
    flex: 0 1 210px;
    min-width: min(100%, 180px);
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 14px;
  }

  .dates {
    font-family: var(--font-display);
    font-size: clamp(15px, 1.15vw, 19px);
    letter-spacing: 0.01em;
    font-variant-numeric: tabular-nums;
    color: var(--ink-muted);
  }

  .sm .dates {
    font-size: clamp(14px, 1vw, 17px);
    color: var(--ink-dim);
  }

  .present {
    color: var(--accent);
  }

  .meta {
    display: flex;
    flex-direction: column;
    gap: 9px;
    padding-top: 14px;
    border-top: 1px solid var(--hairline);
    font-size: 12px;
    line-height: 1.5;
    letter-spacing: 0.13em;
    text-transform: uppercase;
    color: var(--ink-muted);
  }

  /* The reading column carries the timeline, so the line is only ever as long
     as the entry it belongs to. */
  .body {
    position: relative;
    flex: 1 1 620px;
    min-width: min(100%, 300px);
    padding-left: clamp(22px, 3vw, 54px);
    border-left: 1px solid var(--hairline);
  }

  /* Centred on the first line of the title, which is why it is sized off the
     same value the title is. An entry with a kicker pushes it down by that
     row's height instead. */
  .dot {
    position: absolute;
    left: -5.5px;
    top: calc(var(--title-size) * var(--dot-shift) + var(--dot-offset, 0px));
    transform: translateY(-50%);
    width: 11px;
    height: 11px;
    border-radius: 999px;
  }

  .has-tag {
    --dot-offset: 26px;
  }

  .current .dot {
    background: var(--accent);
  }

  .past .dot {
    background: var(--ink-faint);
  }

  .archive .dot {
    background: var(--rule);
  }

  /* Education is not a job, so it is drawn as an aside to the timeline: broken
     rules and a hollow marker rather than a filled one. */
  .education .body {
    border-left-style: dashed;
    border-left-color: var(--hairline-strong);
  }

  .education .meta {
    border-top-style: dashed;
    border-top-color: var(--hairline-strong);
  }

  .education .dot {
    border: 1px solid var(--accent);
    background: var(--bg);
  }

  .tag {
    display: flex;
    align-items: center;
    gap: 9px;
    margin-bottom: 12px;
  }

  .tag-dot {
    width: 5px;
    height: 5px;
    border-radius: 999px;
    border: 1px solid var(--accent);
  }

  .tag-label {
    font-size: 11.5px;
    font-weight: 600;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--accent);
  }

  .head {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    gap: 10px 24px;
    margin-bottom: clamp(18px, 2.2vw, 28px);
  }

  .has-tag .head {
    margin-bottom: clamp(14px, 1.8vw, 22px);
  }

  .title {
    flex: 1 1 auto;
    min-width: 0;
    margin: 0;
    font-family: var(--font-display);
    font-weight: 500;
    font-size: var(--title-size);
    line-height: 1.05;
    letter-spacing: -0.03em;
    color: var(--ink);
  }

  .sm .title {
    line-height: 1.1;
    letter-spacing: -0.025em;
    color: var(--ink-muted);
  }

  .muted {
    color: var(--ink-faint);
  }
</style>
