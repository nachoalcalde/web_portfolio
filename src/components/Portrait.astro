---
import { Image } from 'astro:assets';
import portrait from '../assets/portrait.png';
---

<Image
  class="portrait"
  data-portrait
  src={portrait}
  alt="Nacho Alcalde Cid"
  loading="eager"
  decoding="async"
  fetchpriority="high"
/>

<style>
  .portrait {
    position: absolute;
    bottom: 0;
    left: 50%;
    z-index: 1;
    height: min(94svh, 1020px);
    width: auto;
    max-width: none;
    transform: translateX(-50%);
    transition: transform 0.6s var(--ease-out);
    will-change: transform;
    animation: fade 1.2s ease both;
  }
</style>

<script>
  // <x-dc> held a ref to the <img> and mutated style.transform directly rather
  // than going through state; the same applies here.
  const portrait = document.querySelector<HTMLImageElement>('[data-portrait]');

  if (portrait) {
    const coarse = window.matchMedia('(pointer: coarse)');
    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)');

    const onMove = (event: MouseEvent) => {
      if (coarse.matches || reduced.matches) return;

      const x = (event.clientX / window.innerWidth - 0.5) * 2;
      const y = (event.clientY / window.innerHeight - 0.5) * 2;

      portrait.style.transform =
        `translateX(-50%) translate3d(${(x * -4).toFixed(2)}px, ${(y * -2).toFixed(2)}px, 0)`;
    };

    window.addEventListener('mousemove', onMove, { passive: true });
  }
</script>
