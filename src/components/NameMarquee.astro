---
type Glyph = { char: string; delay: number } | { space: string };

// Per-letter reveal delays are fixed by the design handoff, so they are data,
// not a formula: the gap before the dash does not add the extra beat the
// word gaps do.
const GLYPHS: Glyph[] = [
  { char: 'N', delay: 0.1 },
  { char: 'a', delay: 0.14 },
  { char: 'c', delay: 0.18 },
  { char: 'h', delay: 0.22 },
  { char: 'o', delay: 0.26 },
  { space: '0.26em' },
  { char: 'A', delay: 0.32 },
  { char: 'l', delay: 0.36 },
  { char: 'c', delay: 0.4 },
  { char: 'a', delay: 0.44 },
  { char: 'l', delay: 0.48 },
  { char: 'd', delay: 0.52 },
  { char: 'e', delay: 0.56 },
  { space: '0.26em' },
  { char: 'C', delay: 0.62 },
  { char: 'i', delay: 0.66 },
  { char: 'd', delay: 0.7 },
  { space: '0.22em' },
  { char: '—', delay: 0.74 },
];
---

<div class="marquee">
  <div class="track">
    <h1 class="name">
      {
        GLYPHS.map((glyph) =>
          'space' in glyph ? (
            <span class="gap" style={`width:${glyph.space}`} />
          ) : (
            <span class="mask">
              <span class="glyph" style={`animation-delay:${glyph.delay}s`}>{glyph.char}</span>
            </span>
          )
        )
      }
    </h1>
    <div class="name" aria-hidden="true">
      {
        GLYPHS.map((glyph) =>
          'space' in glyph ? (
            <span class="gap" style={`width:${glyph.space}`} />
          ) : (
            <span class="mask">
              <span class="glyph" style={`animation-delay:${glyph.delay}s`}>{glyph.char}</span>
            </span>
          )
        )
      }
    </div>
  </div>
</div>

<style>
  .marquee {
    position: relative;
    z-index: 3;
    flex: 0 0 auto;
    overflow: hidden;
    padding-bottom: clamp(8px, 1.6vh, 22px);
    pointer-events: none;
  }

  /* Below 1200px the name is laid over the hero rather than stacked under the
     figure: taking it out of the flow is what lets the image run all the way to
     the bottom edge of the screen. The negative insets bleed it past the page
     gutter, or it would scroll inside a boxed-in strip. */
  @media (max-width: 1199px) {
    .marquee {
      position: absolute;
      right: calc(var(--gutter) * -1);
      bottom: 0;
      left: calc(var(--gutter) * -1);
      padding-bottom: calc(clamp(8px, 1.6vh, 22px) + env(safe-area-inset-bottom, 0px));
    }
  }

  .track {
    display: flex;
    width: max-content;
    animation: marquee 30s linear infinite;
  }

  .name {
    display: flex;
    margin: 0;
    padding-right: 0.14em;
    font-family: var(--font-display);
    font-weight: 600;
    font-size: var(--name-size);
    line-height: 0.8;
    letter-spacing: -0.05em;
    white-space: nowrap;
    color: var(--ink);
  }

  .gap {
    display: inline-block;
  }

  .mask {
    display: inline-block;
    overflow: hidden;
  }

  .glyph {
    display: inline-block;
    animation: riseUp 1s var(--ease-rise) both;
  }
</style>
