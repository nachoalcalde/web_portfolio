---
import Layout from '../layouts/Layout.astro';

interface Props {
  name?: string;
  email?: string;
  linkedin?: string;
}

const {
  name = 'Nacho Alcalde Cid',
  email = 'ialcaldecid@gmail.com',
  linkedin = 'https://www.linkedin.com/in/ignacioalcaldecid'
} = Astro.props as Props;

const linkedInUrl = linkedin.startsWith('http') ? linkedin : `https://${linkedin}`;
const mailtoLink = `mailto:${email}`;
---

<Layout title="Nacho Alcalde Cid">
  <div class="container">
    <div class="glow" data-glow="1"></div>

    <header>
      <span class="header-left">Portfolio</span>
      <span class="header-right">MMXXVI</span>
    </header>

    <main>
      <div class="status">
        <span class="status-dot"></span>
        <span>Under maintenance</span>
      </div>

      <h1 id="typewriter-title" data-text={name}></h1>

      <p class="subtitle">
        Web portfolio <em>under construction</em>
      </p>

      <p class="description">
        I'm shaping something new. Come back soon to see it.
      </p>
    </main>

    <footer>
      <div class="contact-section">
        <span class="label">Contact</span>
        <a href={mailtoLink} class="contact-link">{email}</a>
      </div>
      <nav class="social-nav">
        <a href={linkedInUrl} target="_blank" rel="noopener">LinkedIn</a>
      </nav>
    </footer>
  </div>
</Layout>

<script type="module">
  import { animate } from 'motion';

  document.addEventListener('DOMContentLoaded', () => {
    // Glow effect
    const glow = document.querySelector('[data-glow]');
    if (glow) {
      const handleMouseMove = (e) => {
        const container = glow.parentElement;
        if (!container) return;

        const rect = container.getBoundingClientRect();
        const dx = e.clientX - (rect.left + rect.width / 2);
        const dy = e.clientY - (rect.top + rect.height * 0.45);

        glow.style.transform = `translate(-50%, -50%) translate3d(${dx}px, ${dy}px, 0)`;
      };

      window.addEventListener('pointermove', handleMouseMove, { passive: true });
    }

    // Typewriter effect
    const title = document.getElementById('typewriter-title');
    if (title) {
      const fullText = title.getAttribute('data-text') || '';
      title.textContent = '';

      // Animate the title entrance
      animate(title, { opacity: 1, y: 0 }, {
        from: { opacity: 0, y: 28 },
        duration: 1.1,
        ease: [0.2, 0.8, 0.2, 1],
        delay: 0.35,
      });

      // Typewriter effect
      let currentIndex = 0;
      const typeInterval = setInterval(() => {
        if (currentIndex < fullText.length) {
          title.textContent = fullText.slice(0, currentIndex + 1);
          currentIndex++;
        } else {
          clearInterval(typeInterval);
        }
      }, 60);
    }
  });
</script>

<style is:global>
  @import url('https://fonts.googleapis.com/css2?family=Instrument+Serif:ital@0;1&family=Manrope:wght@200;300;400;500&display=swap');

  :root {
    --color-bg: #0c0c0b;
    --color-text: #f4f1ea;
    --color-text-secondary: #8f8b82;
    --color-text-tertiary: #a8a49a;
    --color-accent: #ffd700;
    --color-border: rgba(244, 241, 234, 0.12);
  }

  html,
  body {
    margin: 0;
    padding: 0;
    background: var(--color-bg);
    color: var(--color-text);
  }

  * {
    box-sizing: border-box;
  }

  a {
    color: var(--color-text);
    text-decoration: none;
  }

  a:hover {
    color: var(--color-text-tertiary);
  }

  ::selection {
    background: var(--color-text);
    color: var(--color-bg);
  }

  @keyframes rise {
    from {
      opacity: 0;
      transform: translateY(28px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @keyframes fade {
    from {
      opacity: 0;
    }
    to {
      opacity: 1;
    }
  }

  @keyframes breathe {
    0%,
    100% {
      opacity: 1;
      transform: scale(1);
    }
    50% {
      opacity: 0.35;
      transform: scale(0.8);
    }
  }
</style>

<style>
  .container {
    position: relative;
    min-height: 100dvh;
    background: var(--color-bg);
    color: var(--color-text);
    font-family: Manrope, Helvetica, sans-serif;
    font-weight: 300;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    padding: clamp(20px, 4vw, 48px);
  }

  .glow {
    position: absolute;
    top: 45%;
    left: 50%;
    width: clamp(300px, 80vw, 620px);
    height: clamp(300px, 80vw, 620px);
    transform: translate(-50%, -50%);
    transition: transform 400ms cubic-bezier(0.2, 0.8, 0.2, 1);
    border-radius: 50%;
    background: radial-gradient(
      circle,
      rgba(255, 215, 0, 0.13),
      rgba(255, 215, 0, 0) 65%
    );
    pointer-events: none;
    animation: fade 2s ease 0.6s both;
  }

  header {
    position: relative;
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: clamp(12px, 4vw, 24px);
    font-size: clamp(10px, 2.5vw, 12px);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-text-secondary);
    animation: fade 1.2s ease 0.1s both;
  }

  main {
    position: relative;
    flex: 1;
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: clamp(32px, 6vh, 96px) 0;
  }

  .status {
    display: flex;
    align-items: center;
    gap: clamp(8px, 2vw, 10px);
    margin-bottom: clamp(20px, 3vh, 32px);
    font-size: clamp(10px, 2.5vw, 12px);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-text-secondary);
    animation: rise 1s cubic-bezier(0.2, 0.8, 0.2, 1) 0.25s both;
  }

  .status-dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--color-accent);
    animation: breathe 2.4s ease-in-out infinite;
  }

  h1 {
    margin: 0;
    font-weight: 200;
    font-size: clamp(26px, 5.6vw, 96px);
    line-height: 1;
    letter-spacing: -0.035em;
    white-space: normal;
    word-break: break-word;
    animation: rise 1.1s cubic-bezier(0.2, 0.8, 0.2, 1) 0.35s both;
  }

  @media (min-width: 768px) {
    h1 {
      white-space: nowrap;
    }
  }

  .subtitle {
    margin: clamp(22px, 4vh, 38px) 0 0;
    font-size: clamp(18px, 2.4vw, 32px);
    font-weight: 300;
    letter-spacing: -0.015em;
    line-height: 1.25;
    color: var(--color-text);
    animation: rise 1.1s cubic-bezier(0.2, 0.8, 0.2, 1) 0.58s both;
  }

  .subtitle em {
    font-family: 'Instrument Serif', Georgia, serif;
    font-style: italic;
    font-weight: 400;
    color: var(--color-text-tertiary);
  }

  .description {
    margin: clamp(18px, 3vh, 28px) 0 0;
    max-width: 30ch;
    font-size: clamp(15px, 1.5vw, 18px);
    line-height: 1.6;
    color: var(--color-text-secondary);
    animation: rise 1.1s cubic-bezier(0.2, 0.8, 0.2, 1) 0.7s both;
  }

  footer {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: clamp(16px, 3vw, 20px);
    padding-top: 24px;
    border-top: 1px solid var(--color-border);
    animation: fade 1.4s ease 0.8s both;
  }

  @media (min-width: 768px) {
    footer {
      flex-direction: row;
      justify-content: space-between;
      align-items: flex-end;
      gap: 20px 32px;
    }
  }

  .contact-section {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .label {
    font-size: clamp(9px, 2.5vw, 11px);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: #6f6c65;
  }

  .contact-link {
    font-size: clamp(14px, 1.6vw, 18px);
    letter-spacing: -0.01em;
    border-bottom: 1px solid rgba(244, 241, 234, 0.25);
    padding-bottom: 2px;
  }

  .social-nav {
    display: flex;
    gap: clamp(16px, 4vw, 24px);
    font-size: clamp(10px, 2.5vw, 12px);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-text-secondary);
  }

  .social-nav a {
    color: var(--color-text-secondary);
  }
</style>
